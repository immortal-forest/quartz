# quartz: Ghostty. Its built-in font (JetBrains Mono + Nerd Font symbols)
# covers the prompt's icons, so no extra font is needed.
# Every option: ghostty +show-config --default --docs
font-size = 13
cursor-style = block
background-opacity = 0.92

window-decoration = false
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

shell-integration-features = no-cursor,sudo,title
